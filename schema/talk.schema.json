{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hextra-toolbox/schema/talk.schema.json",
  "title": "Hextra weekly toolbox talk",
  "description": "One weekly toolbox talk. File name must be talks/<id>.json. See SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "date", "week_label", "sources_reviewed", "key_risk",
    "drivers_need_to_know", "supervisors_must_check", "discussion_questions",
    "practical_checklist", "required_records", "follow_up_actions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(-[a-z0-9]+(-[a-z0-9]+)*)?$", "description": "YYYY-MM-DD, optionally with a lowercase suffix (e.g. 2026-10-06-b). Must start with the value of date." },
    "title": { "type": "string", "minLength": 5, "maxLength": 140 },
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Talk date (Australia/Sydney), ISO YYYY-MM-DD." },
    "week_label": { "type": "string", "minLength": 3, "maxLength": 80 },
    "summary": { "type": "string", "maxLength": 800, "description": "Optional one-paragraph intro shown under the title." },
    "prepared_by": { "type": "string", "maxLength": 120 },
    "sources_reviewed": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "title", "url", "date"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "description": "Publisher, e.g. NHVR, SafeWork NSW, Big Rigs." },
          "title": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "date": { "type": "string", "pattern": "^(\\d{4}(-\\d{2}(-\\d{2})?)?|undated)$", "description": "Publication date YYYY-MM-DD, YYYY-MM or YYYY, or 'undated'." },
          "type": { "enum": ["regulator", "government", "industry", "other"] },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "key_risk": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "drivers_need_to_know": { "$ref": "#/$defs/stringList" },
    "supervisors_must_check": { "$ref": "#/$defs/stringList" },
    "discussion_questions": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/text" } },
    "practical_checklist": { "$ref": "#/$defs/stringList" },
    "required_records": {
      "oneOf": [ { "$ref": "#/$defs/stringList" }, { "$ref": "#/$defs/text" } ]
    },
    "follow_up_actions": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/text" },
          {
            "type": "object", "additionalProperties": false, "required": ["action"],
            "properties": {
              "action": { "$ref": "#/$defs/text" },
              "owner": { "type": "string", "maxLength": 80 },
              "due": { "type": "string", "maxLength": 40 }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 3, "maxLength": 1200 },
    "stringList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
  }
}
