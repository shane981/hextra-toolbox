# Deploy settings for scripts/publish.sh (sourced as shell variables)
# auto = first authenticated of: gh (GitHub Pages) -> netlify -> wrangler (Cloudflare Pages) -> DEPLOY_GIT_REMOTE
DEPLOY_TARGET=auto
# GitHub Pages: repo is created on first deploy if missing. Free plans need it PUBLIC for Pages.
GH_REPO=shane981/hextra-toolbox
GH_VISIBILITY=public
DEPLOY_BRANCH=gh-pages
SITE_URL=https://shane981.github.io/hextra-toolbox/
# Netlify / Cloudflare alternatives (only used if that target is chosen)
# NETLIFY_SITE_ID=
# CF_PAGES_PROJECT=hextra-toolbox
